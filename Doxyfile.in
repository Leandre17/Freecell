# Doxyfile configuration template for Freecell
PROJECT_NAME       = @DOXYGEN_PROJECT_NAME@
OUTPUT_DIRECTORY   = @DOXYGEN_OUTPUT_DIR@
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL        = YES
RECURSIVE          = YES
INPUT              = @DOXYGEN_INPUT_DIR@
FILE_PATTERNS      = *.cpp *.h *.hpp *.md *.dox
GENERATE_HTML      = YES
HTML_OUTPUT        = html
GENERATE_LATEX     = NO
GENERATE_MAN       = NO
GENERATE_RTF       = NO
GENERATE_XML       = NO
QUIET              = NO
WARNINGS           = YES
WARN_IF_UNDOCUMENTED = YES
INLINE_SOURCES     = YES
SOURCE_BROWSER     = NO

# Use project version if available
PROJECT_NUMBER     = @PROJECT_VERSION@
